# Copy this file to .env and fill in your values. NEVER commit .env.

# --- Gemini model access for the ADK agents (free key: https://aistudio.google.com/apikey)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key-here
ADK_MODEL=gemini-3.8-flash

# --- Cloud storage (Google Cloud Storage)
STORAGE_BACKEND=gcs
GCS_BUCKET=your-bucket-name
GCS_PREFIX=countries-pipeline
# Auth uses Application Default Credentials: run `gcloud auth application-default login`

# --- Local output folder
OUTPUT_DIR=output
